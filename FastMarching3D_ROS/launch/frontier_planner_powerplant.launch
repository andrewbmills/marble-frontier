<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="model_name" default="firefly"/>
  <arg name="resolution" default="0.2"/>

  <group ns="$(arg model_name)">
    <node pkg="msfm3d" type="frontier" name="frontier_node">
      <param name="update_rate" value="3.0" />
      <param name="map_type" value="edt" />
      <param name="voxel_size" value="$(arg resolution)"/>
      <param name="cluster_size" value="100"/>
      <!-- <param name="normal_z_filter" value="0.4"/> -->
      <param name="filter_by_normal" value="false"/>
      
      <param name="min_obstacle_distance" value="0.0"/>
      <param name="max_obstacle_distance" value="1.6"/>

      <param name="filter_by_bbox" value="true"/>
      <param name="bbox_min_z" value = "0.0"/>
      <param name="bbox_max_z" value = "21.0"/>
      <param name="bbox_min_y" value = "5.0"/>
      <param name="bbox_max_y" value = "35.0"/>
      <param name="bbox_min_x" value = "-40.0"/>
      <param name="bbox_max_x" value = "-10.0"/>

      <remap from="octomap_binary" to="octomap_ignore"/>
      <remap from="octomap_full" to="octomap_ignore"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="pcl_manager_cropbox_frontier" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cropbox_frontier" args="load pcl/CropBox pcl_manager_cropbox_frontier">
      <remap from="~input" to="frontier" />
      <remap from="~output" to="frontier_filtered" />
      <rosparam>
        negative: true
        min_x: -2.0
        max_x: 2.0
        min_y: -2.0
        max_y: 2.0
        min_z: -1.5
        max_z: 1.5
      </rosparam>
    </node>

    <node pkg="msfm3d" type="frontier_planner" name="frontier_planner" output="screen">
      <param name="update_rate" value="1.0"/>
      <param name="voxel_size" value="$(arg resolution)"/>
      <param name="num_agents" value="1"/>
      <param name="goal_separation_distance" value="3.0"/>
      <param name="speed_safe" value="0.0"/>
      <param name="speed_max" value="3.0"/>
      <param name="marching_timeout" value="15.0"/>
      <param name="path_mode" value="gradient"/>
      <param name="turn_rate" value="30.0"/>

      <remap from="speed_map" to="edt"/>
      <remap from="path" to="planned_path"/>
      <remap from="odometry" to="odometry_stitch"/>
      <remap from="frontier" to="frontier_filtered"/>
    </node>

    <include file="$(find marble_guidance)/launch/guidance_air_gazebo.launch"/>
    <include file="$(find receding_horizon_stitcher)/launch/stitcher_gazebo.launch"/>
  </group>
</launch>