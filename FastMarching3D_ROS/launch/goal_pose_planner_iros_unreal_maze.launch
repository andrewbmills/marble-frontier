<?xml version="1.0" encoding="UTF-8"?>
<launch>
  
  <arg name="model_name" default="firefly"/>
  <arg name="resolution" default="0.2"/>

  <group ns="$(arg model_name)">
    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
      <param name="resolution" value="$(arg resolution)" />
      <!-- fixed map frame (set to 'map' if SLAM or localization running!) -->
      <param name="frame_id" type="string" value="world" />
      <!-- maximum range to integrate (speedup!) -->
      <param name="sensor_model/max_range" value="4.7" />
      <!-- data source to integrate (PointCloud2) -->
      <remap from="cloud_in" to="/unreal/unreal_sensor_model/ue_sensor_out" />
    </node>

    <node pkg="msfm3d" type="frontier" name="frontier_node" respawn="true">
      <param name="update_rate" value="3.0" />
      <param name="map_type" value="octomap" />
      <param name="voxel_size" value="$(arg resolution)"/>
      <param name="cluster_size" value="100"/>
      <param name="filterByNormal" value="false"/>

      <param name="filter_by_bbox" value="true"/>
      <param name="bbox_min_x" value = "-20.0"/>
      <param name="bbox_max_x" value = "20.0"/>
      <param name="bbox_min_y" value = "-20.0"/>
      <param name="bbox_max_y" value = "20.0"/>
      <param name="bbox_min_z" value = "-1.5"/>
      <param name="bbox_max_z" value = "1.5"/>

      <remap from="edt" to="edt_ignore"/>
      <remap from="octomap_full" to="octomap_ignore"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="pcl_manager_cropbox_frontier" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cropbox_frontier" args="load pcl/CropBox pcl_manager_cropbox_frontier">
      <remap from="~input" to="frontier" />
      <remap from="~output" to="frontier_clean" />
      <rosparam>
        negative: true
        min_x: -2.0
        max_x: 2.0
        min_y: -2.0
        max_y: 2.0
        min_z: -1.5
        max_z: 1.5
      </rosparam>
    </node>

    <node pkg="nodelet" type="nodelet" name="pcl_manager_cropbox_frontier2" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cropbox_frontier2" args="load pcl/CropBox pcl_manager_cropbox_frontier2">
      <remap from="~input" to="frontier_clean" />
      <remap from="~output" to="frontier_filtered" />
      <rosparam>
        negative: false
        min_x: -20.0
        max_x: 20.0
        min_y: -20.0
        max_y: 20.0
        min_z: -1.5
        max_z: 1.5
      </rosparam>
    </node>

    <node pkg="nodelet" type="nodelet" name="pcl_manager_cropbox_edt" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cropbox_edt" args="load pcl/CropBox pcl_manager_cropbox_edt">
      <remap from="~input" to="edt" />
      <remap from="~output" to="edt_filtered" />
      <rosparam>
        negative: false
        min_x: -20.0
        max_x: 20.0
        min_y: -20.0
        max_y: 20.0
        min_z: -1.5
        max_z: 1.5
      </rosparam>
    </node>

    <node pkg="msfm3d" type="goal_pose_sampler" name="goal_pose_sampler" output="screen" respawn="true">
      <param name="update_rate" value="3.0" />
      <param name="voxel_size" value="$(arg resolution)"/>
      <param name="sample_mode" type="string" value="uniform"/>
      <param name="pose_sampling_limit" value="10"/>
      <!-- <param name="sensor_rMin" value="0.5"/> -->
      <!-- <param name="sensor_rMax" value="4.0"/> -->
      <param name="sensor_vertical_FoV" value="30.0"/>
      <param name="sensor_horizontal_FoV" value="60.0"/>
      <param name="sensor_rMin" value="0.0"/>
      <param name="sensor_rMax" value="5.0"/>
      <param name="sampling_radius_ratio" value="0.30"/>
      <!-- <param name="sensor_vertical_FoV" value="45.0"/> -->
      <!-- <param name="sensor_horizontal_FoV" value="180.0"/> -->
      <param name="sensor_type" type="string" value="camera"/>
      <param name="gain_type" type="string" value="unseen"/>
      <param name="gain_debug_mode" type="string" value="normal"/>
      <param name="robot_proximity_filter_radius" value="1.0"/>
      <!-- <param name="group_radius" value="0.82"/> -->
      <!-- <param name="min_obstacle_proximity" value="1.2"/> -->
      <param name="min_obstacle_proximity" value="1.0"/>
      <param name="check_LoS" value = "true"/>

      <remap from="octomap_binary" to="octomap_ignore"/>
      <remap from="frontier" to="frontier_filtered"/>
      <remap from="edt" to="edt_filtered"/>
    </node>

    <node pkg="msfm3d" type="goal_pose_planner" name="goal_pose_planner" respawn="true">
      <param name="update_rate" value="2.0"/>
      <param name="voxel_size" value="$(arg resolution)"/>
      <param name="num_agents" value="1"/>
      <param name="goal_separation_distance" value="3.0"/>
      <param name="speed_max" value="5.0"/>
      <param name="speed_safe" value="1.0"/>
      <param name="marching_timeout" value="15.0"/>
      <param name="path_mode" value="gradient"/>
      <param name="turn_rate" value="30.0"/>

      <remap from="speed_map" to="edt_filtered"/>
      <remap from="path" to="planned_path"/>
      <remap from="odometry" to="odometry_stitch"/>
    </node>

    <include file="$(find marble_guidance)/launch/guidance_air.launch"/>
    <!-- <include file="$(find marble_guidance)/launch/guidance.launch"/> -->
    <include file="$(find receding_horizon_stitcher)/launch/stitcher.launch"/>

  </group>
</launch>